 "cards": [
  {
   "id": "c1",
   "sec": "s3",
   "q": "Wat is het kenmerk van een wisselspanning?",
   "a": "Ze wisselt voortdurend van polariteit (teken): de stroom gaat heen en weer."
  },
  {
   "id": "c2",
   "sec": "s4",
   "q": "Welke vormen van wisselspanning ken je?",
   "a": "Sinus, blok, driehoek en zaagtand."
  },
  {
   "id": "c3",
   "sec": "s5",
   "q": "Hoe hangen frequentie f en periodeduur T samen?",
   "a": "f = 1 / T en T = 1 / f."
  },
  {
   "id": "c4",
   "sec": "s5",
   "q": "Wat is de periodeduur van de netspanning (50 Hz)?",
   "a": "1/50 s = 20 ms."
  },
  {
   "id": "c5",
   "sec": "s5",
   "q": "Een golfvorm heeft een periodeduur van 2 ms. Hoe groot is de frequentie?",
   "a": "f = 1 / 0,002 s = 500 Hz."
  },
  {
   "id": "c6",
   "sec": "s5",
   "q": "Wat is de amplitude?",
   "a": "De maximale uitwijking uit de nulstand (de maximale waarde)."
  },
  {
   "id": "c7",
   "sec": "s5",
   "q": "Wat is de gemiddelde waarde van een zuivere wisselspanning over een hele periode?",
   "a": "Nul."
  },
  {
   "id": "c8",
   "sec": "s5",
   "q": "Wat is de effectieve waarde van een sinus met amplitude Umax?",
   "a": "U_eff = Umax / √2 ≈ 0,7 · Umax."
  },
  {
   "id": "c9",
   "sec": "s5",
   "q": "Hoe bereken je Umax uit de effectieve waarde?",
   "a": "Umax = U_eff · √2 ≈ 1,4 · U_eff. De netspanning 230 V eff heeft dus een top van ongeveer 325 V."
  },
  {
   "id": "c10",
   "sec": "s5",
   "q": "Wat is de effectieve waarde van een blokspanning met amplitude A?",
   "a": "U_eff = A (een blok is steeds op zijn maximum)."
  },
  {
   "id": "c11",
   "sec": "s5",
   "q": "Wat betekent de effectieve waarde?",
   "a": "De gelijkspanning die in een weerstand evenveel warmte (vermogen) geeft."
  },
  {
   "id": "c12",
   "sec": "s5",
   "q": "Hoeveel graden hoort bij een halve periode, en bij een kwart periode?",
   "a": "180° en 90°."
  },
  {
   "id": "c13",
   "sec": "s5",
   "q": "Wat is de hoekfrequentie ω?",
   "a": "ω = 2π · f (in rad/s)."
  },
  {
   "id": "c14",
   "sec": "s6",
   "q": "Hoe bepaal je het gelijkspanningsdeel van een mengvorm?",
   "a": "Het gelijkstroomdeel is de gemiddelde waarde van het signaal."
  },
  {
   "id": "c15",
   "sec": "s9",
   "q": "Hoe tel je twee gelijkspanningen of -stromen op?",
   "a": "Gewoon rekenkundig (let op de polariteit)."
  },
  {
   "id": "c16",
   "sec": "s10",
   "q": "Hoe tel je twee wisselspanningen op die 90° in fase verschillen?",
   "a": "Met Pythagoras: U = √(U₁² + U₂²), omdat de vectoren loodrecht op elkaar staan."
  },
  {
   "id": "c17",
   "sec": "s10",
   "q": "Hoe tel je twee even grote wisselspanningen op die in fase zijn?",
   "a": "De amplituden tellen op (bij gelijke frequentie): twee keer zo groot."
  },
  {
   "id": "c18",
   "sec": "s10",
   "q": "Hoe tel je twee even grote wisselspanningen op die in tegenfase (180°) zijn?",
   "a": "Ze heffen elkaar op: de som is nul."
  },
  {
   "id": "c19",
   "sec": "s13",
   "q": "Wat is het faseverschil tussen stroom en spanning bij een condensator?",
   "a": "90°: de stroom loopt voor op de spanning."
  },
  {
   "id": "c20",
   "sec": "s14",
   "q": "Wat is het faseverschil tussen stroom en spanning bij een spoel?",
   "a": "90°: de spanning loopt voor op de stroom."
  },
  {
   "id": "c21",
   "sec": "s14",
   "q": "Wat is het faseverschil tussen stroom en spanning bij een weerstand?",
   "a": "0°: ze lopen gelijk op."
  },
  {
   "id": "c22",
   "sec": "s17",
   "q": "Welk ezelsbruggetje onthoudt het faseverschil bij L en C?",
   "a": "LUI: bij L loopt U voor op I. En bij C loopt I voor op U (CIU). Oudere variant: LEICIE."
  },
  {
   "id": "c23",
   "sec": "s19",
   "q": "Formule voor de reactantie van een condensator?",
   "a": "X_C = 1 / (2π · f · C) = 1 / (ω · C)."
  },
  {
   "id": "c24",
   "sec": "s19",
   "q": "Formule voor de reactantie van een spoel?",
   "a": "X_L = 2π · f · L = ω · L."
  },
  {
   "id": "c25",
   "sec": "s19",
   "q": "Hoe verandert X_C met de frequentie?",
   "a": "X_C wordt kleiner als f groter wordt (omgekeerd evenredig)."
  },
  {
   "id": "c26",
   "sec": "s19",
   "q": "Hoe verandert X_L met de frequentie?",
   "a": "X_L wordt groter als f groter wordt (evenredig)."
  },
  {
   "id": "c27",
   "sec": "s19",
   "q": "Wat is de wet van Ohm voor een reactantie?",
   "a": "U_eff = I_eff · X (met X = X_C of X_L)."
  },
  {
   "id": "c28",
   "sec": "s19",
   "q": "Wat doet een condensator bij gelijkspanning (f = 0), en een spoel?",
   "a": "Condensator: X_C is oneindig (blokkeert). Spoel: X_L = 0 (geleidt)."
  },
  {
   "id": "c29",
   "sec": "s20",
   "q": "Wanneer is een LC-kring in resonantie?",
   "a": "Als X_L = X_C."
  },
  {
   "id": "c30",
   "sec": "s20",
   "q": "Wat is er bijzonder aan een seriekring in resonantie?",
   "a": "De impedantie is minimaal (alleen de verliesweerstand R), dus de stroom is maximaal. De spanningen over L en C zijn even groot en tegengesteld."
  },
  {
   "id": "c31",
   "sec": "s20",
   "q": "Wat is er bijzonder aan een parallelkring in resonantie?",
   "a": "De impedantie is maximaal, dus de stroom uit de bron is minimaal. De stromen door L en C zijn even groot en tegengesteld."
  },
  {
   "id": "c32",
   "sec": "s20",
   "q": "Wanneer gedraagt een seriekring zich als spoel, en wanneer als condensator?",
   "a": "Boven de resonantiefrequentie is X_L groter: inductief (als spoel). Eronder is X_C groter: capacitief."
  },
  {
   "id": "c33",
   "sec": "s20",
   "q": "Wanneer gedraagt een parallelkring zich als spoel?",
   "a": "Onder de resonantiefrequentie: de spoel heeft dan de laagste reactantie en neemt de meeste stroom."
  },
  {
   "id": "c34",
   "sec": "s21",
   "q": "Formule van Thomson voor de resonantiefrequentie?",
   "a": "f_res = 1 / (2π · √(L · C))."
  },
  {
   "id": "c35",
   "sec": "s21",
   "q": "Wat gebeurt er met f_res als C twee keer zo groot wordt?",
   "a": "f_res wordt √2 keer zo laag (delen door ongeveer 1,41)."
  },
  {
   "id": "c36",
   "sec": "s21",
   "q": "Wat gebeurt er met f_res als L en C allebei 2 keer zo groot worden?",
   "a": "f_res wordt 2 keer zo laag."
  },
  {
   "id": "c37",
   "sec": "s22",
   "q": "Wat is impedantie?",
   "a": "De schijnbare weerstand van een weerstand en een reactantie samen, in ohm (symbool Z)."
  },
  {
   "id": "c38",
   "sec": "s22",
   "q": "Impedantie van R en X in serie?",
   "a": "Z = √(R² + X²)."
  },
  {
   "id": "c39",
   "sec": "s22",
   "q": "Impedantie van R en X parallel?",
   "a": "1/Z = √(1/R² + 1/X²)."
  },
  {
   "id": "c40",
   "sec": "s22",
   "q": "Een weerstand van 30 Ω in serie met X_L = 40 Ω. Hoe groot is Z?",
   "a": "Z = √(30² + 40²) = 50 Ω."
  },
  {
   "id": "c41",
   "sec": "s25",
   "q": "Welke vier filtersoorten ken je?",
   "a": "Laagdoorlaat, hoogdoorlaat, bandsper en banddoorlaat."
  },
  {
   "id": "c42",
   "sec": "s26",
   "q": "Wat doet een laagdoorlaatfilter?",
   "a": "Laat lage frequenties door en verzwakt hoge."
  },
  {
   "id": "c43",
   "sec": "s26",
   "q": "Hoe ziet een eenvoudig RC-laagdoorlaatfilter eruit?",
   "a": "Een weerstand in serie, met de uitgang over de condensator (naar massa). X_C wordt kleiner bij hoge f, dus de uitgangsspanning daalt."
  },
  {
   "id": "c44",
   "sec": "s26",
   "q": "Formule voor de kantelfrequentie van een RC-filter?",
   "a": "f_k = 1 / (2π · R · C). Daar geldt R = X_C."
  },
  {
   "id": "c45",
   "sec": "s26",
   "q": "Formule voor de kantelfrequentie van een RL-filter?",
   "a": "f_k = R / (2π · L). Daar geldt R = X_L."
  },
  {
   "id": "c46",
   "sec": "s26",
   "q": "Hoeveel is de versterking van een eenvoudig filter bij de kantelfrequentie?",
   "a": "−3 dB (de verzwakking is 3 dB; het vermogen is gehalveerd, de spanning ×0,7)."
  },
  {
   "id": "c47",
   "sec": "s27",
   "q": "Wat doet een hoogdoorlaatfilter?",
   "a": "Laat hoge frequenties door en verzwakt lage; je kunt het zien als een laagdoorlaatfilter met R en C verwisseld."
  },
  {
   "id": "c48",
   "sec": "s28",
   "q": "Wat is de kwaliteitsfactor Q van een seriekring?",
   "a": "Q = X_L,res / R_verlies = ω_res · L / R_verlies (op resonantie)."
  },
  {
   "id": "c49",
   "sec": "s28",
   "q": "Wat is de kwaliteitsfactor Q van een parallelkring?",
   "a": "Q = R_verlies / X_L,res = R_verlies / (ω_res · L) (de vergelijking staat op zijn kop t.o.v. de seriekring)."
  },
  {
   "id": "c50",
   "sec": "s28",
   "q": "Hoe hangen bandbreedte B, Q en f_res samen?",
   "a": "B = f_res / Q (en dus Q = f_res / B). Hoe groter Q, des te smaller de bandbreedte."
  },
  {
   "id": "c51",
   "sec": "s28",
   "q": "Tussen welke punten meet je de bandbreedte?",
   "a": "Tussen de twee −3 dB-punten (flanken) van de resonantiekromme."
  },
  {
   "id": "c52",
   "sec": "s28",
   "q": "Wat gebeurt er met Q als de verliesweerstand van een seriekring groter wordt?",
   "a": "Q wordt kleiner: de kring is minder scherp en de bandbreedte neemt toe."
  },
  {
   "id": "c53",
   "sec": "s29",
   "q": "Wat doet een bandsperfilter?",
   "a": "Het verzwakt een frequentieband en laat hogere en lagere frequenties door."
  },
  {
   "id": "c54",
   "sec": "s32",
   "q": "Waaruit bestaat een blokgolf volgens Fourier?",
   "a": "Uit de grondgolf en alle oneven harmonischen (3×, 5×, 7×, …) met afnemende amplitude (A/3, A/5, A/7)."
  },
  {
   "id": "c55",
   "sec": "s32",
   "q": "Wat is een harmonische?",
   "a": "Een sinus met een geheel veelvoud van de grondfrequentie."
  },
  {
   "id": "c56",
   "sec": "s33",
   "q": "Wat doet een laagdoorlaatfilter met de harmonischen van een signaal?",
   "a": "Het verzwakt ze, zodat het signaal meer op een sinus gaat lijken."
  }
 ],
