 "formulas": [
  {
   "title": "Wisselspanning",
   "items": [
    {
     "f": "f = 1 / T   ·   T = 1 / f",
     "t": "frequentie in Hz, periodeduur in s"
    },
    {
     "f": "ω = 2π · f",
     "t": "hoekfrequentie in rad/s"
    },
    {
     "f": "U_eff = U_max / √2 ≈ 0,7 · U_max",
     "t": "sinus; omgekeerd U_max = U_eff · √2 ≈ 1,4 · U_eff"
    },
    {
     "f": "Blok: U_eff = A",
     "t": "gemiddelde waarde van zuivere wisselspanning = 0"
    }
   ]
  },
  {
   "title": "Reactantie en fase",
   "items": [
    {
     "f": "X_C = 1 / (2π · f · C) = 1 / (ω · C)",
     "t": "condensator: daalt met f; stroom loopt 90° voor op spanning"
    },
    {
     "f": "X_L = 2π · f · L = ω · L",
     "t": "spoel: stijgt met f; spanning loopt 90° voor op stroom (LUI)"
    },
    {
     "f": "U_eff = I_eff · X",
     "t": "wet van Ohm voor een reactantie"
    },
    {
     "f": "Optellen bij 90°: U = √(U₁² + U₂²)",
     "t": "vectoren loodrecht (Pythagoras)"
    }
   ]
  },
  {
   "title": "Resonantie en impedantie",
   "items": [
    {
     "f": "X_L = X_C   →   f_res = 1 / (2π · √(L · C))",
     "t": "vergelijking van Thomson"
    },
    {
     "f": "Serie: Z minimaal (= R), stroom maximaal",
     "t": "in resonantie"
    },
    {
     "f": "Parallel: Z maximaal, bronstroom minimaal",
     "t": "in resonantie"
    },
    {
     "f": "Serie: Z = √(R² + X²)",
     "t": "parallel: 1/Z = √(1/R² + 1/X²)"
    }
   ]
  },
  {
   "title": "Filters",
   "items": [
    {
     "f": "RC: f_k = 1 / (2π · R · C)",
     "t": "kantelfrequentie; daar R = X en −3 dB"
    },
    {
     "f": "RL: f_k = R / (2π · L)",
     "t": "kantelfrequentie van een RL-filter"
    },
    {
     "f": "Q (serie) = X_L,res / R_verlies",
